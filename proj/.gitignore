# Keep local environment and Firebase credentials out of source control.
.env
.env.*
!.env.example
google-services*.json
GoogleService-Info.plist

# Miscellaneous
*.class
*.log
*.pyc
*.hprof
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties
/android/*.jks
/android/*.keystore

# Local release signing material and Android diagnostic output
/upload-keystore.jks
/upload_certificate.pem
/upload-keystore-reset.jks
/upload_certificate_reset.pem
/app_signing_certificates.zip
/android/java_pid*.hprof
/android/build/reports/problems/problems-report.html
