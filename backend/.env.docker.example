# Copy to backend/app/.env before running `docker compose up` from backend/.
APP_NAME="FarmApp"
APP_ENV=local
# Generate with `php artisan key:generate --show` and paste the result here.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

DB_DATABASE=app_db
DB_USERNAME=app_user
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_LOCAL_DB_ROOT_PASSWORD

CORS_ALLOWED_ORIGINS=http://localhost

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS endpoint; use a tunnel while testing locally.
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
